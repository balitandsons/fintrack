# Own rewrite context (stops the main WordPress site's rules from applying here)
RewriteEngine On
Options -Indexes
DirectoryIndex index.php

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Never serve app internals, data or repo files
RewriteRule ^(data|inc)(/|$) - [F,L]
RewriteRule (^|/)\.(git|env|gitignore) - [F,L]
RewriteRule \.(md|json|lock)$ - [F,L]

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
